{
  "name": "hear",
  "version": "0.1.0",
  "description": "Hierarchical-agent runtime for an articulated robot in a virtual 3D world",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-zhangyang/hear-3d-robot.git"
  },
  "bugs": {
    "url": "https://github.com/multi-zhangyang/hear-3d-robot/issues"
  },
  "homepage": "https://github.com/multi-zhangyang/hear-3d-robot#readme",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "hear": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx watch src/cli.ts operator --host 127.0.0.1 --port 8765 --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/cli.js operator",
    "hear": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:production": "pnpm run build && node tests/production-smoke.mjs",
    "test:browser": "pnpm run build:web && playwright test",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:production"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.102",
    "@ai-sdk/openai": "^3.0.88",
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@ant-design/icons": "^6.3.2",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fastify/static": "^10.1.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@openai/agents": "^0.14.1",
    "@openai/agents-extensions": "^0.14.1",
    "ai": "^6.0.235",
    "antd": "^5.29.3",
    "closed-chain-ik": "^0.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recast-navigation": "^0.43.1",
    "three": "^0.185.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
