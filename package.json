{
  "name": "hear",
  "version": "0.1.0",
  "description": "Autonomous hierarchical-agent runtime for a MuJoCo humanoid in an interactive 3D world",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-zhangyang/hear-3d-robot.git"
  },
  "bugs": {
    "url": "https://github.com/multi-zhangyang/hear-3d-robot/issues"
  },
  "homepage": "https://github.com/multi-zhangyang/hear-3d-robot#readme",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "hear": "./dist/cli.js"
  },
  "exports": {
    "./controllers/mjlab-g1-velocity": "./dist/controllers/mjlab-g1-velocity-module.js",
    "./controllers/workyard-contact": "./dist/controllers/workyard-contact-module.js",
    "./controllers/yahmp": "./dist/controllers/yahmp-module.js"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx watch src/cli.ts operator --host 127.0.0.1 --port 8765 --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/cli.js operator",
    "hear": "tsx src/cli.ts",
    "check:dead": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:production": "pnpm run build && node tests/production-smoke.mjs",
    "test:live": "pnpm run test:live:mission",
    "test:live:mission": "pnpm run build:server && node tests/live-autonomy.mjs",
    "test:live:continuous": "pnpm run build:server && node tests/live-continuous-autonomy.mjs",
    "test:live:manipulation": "pnpm run build:server && node tests/live-manipulation.mjs",
    "test:live:endurance": "pnpm run build:server && node tests/live-endurance.mjs",
    "test:browser": "pnpm run build:web && playwright test",
    "benchmark:humanoid": "tsx src/cli.ts benchmark",
    "export:harness-rollouts": "tsx src/cli.ts export-harness-rollouts --runs-dir runs",
    "validate:workyard-training": "tsx src/training/workyard-contract-cli.ts",
    "validate:workyard-residual-training": "tsx src/training/workyard-residual-contract-cli.ts",
    "validate:workyard-contact-training": "tsx src/training/workyard-contact-contract-cli.ts",
    "validate:workyard-observation-parity": "tsx src/training/workyard-observation-parity-cli.ts",
    "smoke:workyard:colab": "node training/run-workyard-colab-smoke.mjs",
    "smoke:workyard:residual:colab": "node training/run-workyard-colab-residual.mjs --mode smoke",
    "teacher:workyard:residual:colab": "node training/run-workyard-colab-residual.mjs --mode teacher",
    "smoke:workyard:residual:local": "node training/run-workyard-colab-residual.mjs --backend local --mode smoke",
    "teacher:workyard:residual:local": "node training/run-workyard-colab-residual.mjs --backend local --mode teacher",
    "smoke:workyard:contact:local": "node training/run-workyard-colab-contact.mjs --backend local --mode smoke",
    "teacher:workyard:contact:local": "node training/run-workyard-colab-contact.mjs --backend local --mode teacher",
    "smoke:workyard:contact:colab": "node training/run-workyard-colab-contact.mjs --mode smoke",
    "teacher:workyard:contact:colab": "node training/run-workyard-colab-contact.mjs --mode teacher",
    "pilot:workyard:contact:colab": "node training/run-workyard-colab-contact.mjs --mode pilot",
    "train:workyard:contact:colab": "node training/run-workyard-colab-contact.mjs --mode train",
    "export:workyard:contact:colab": "node training/run-workyard-contact-export-colab.mjs",
    "export:workyard:reach:colab": "node training/run-workyard-reach-export-colab.mjs",
    "install:workyard:policies": "node training/install-workyard-policy-assets.mjs",
    "train:workyard:colab": "node training/run-workyard-colab-ppo.mjs",
    "train:workyard:residual:colab": "node training/run-workyard-colab-residual.mjs --mode train",
    "train:g1:colab": "node training/run-colab.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "check": "pnpm run check:dead && pnpm run typecheck && pnpm run test && pnpm run test:production"
  },
  "knip": {
    "ignoreBinaries": [
      "wsl.exe",
      "taskkill.exe"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.34",
    "@ai-sdk/openai": "4.0.34",
    "@ai-sdk/openai-compatible": "3.0.25",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mujoco/mujoco": "^3.11.0",
    "@openai/agents": "^0.15.0",
    "@openai/agents-extensions": "^0.15.0",
    "ai": "7.0.56",
    "async-mutex": "^0.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recast-navigation": "^0.43.1",
    "three": "^0.185.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "knip": "^6.32.0",
    "tar": "^7.5.22",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
