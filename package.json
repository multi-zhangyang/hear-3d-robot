{
  "name": "hear",
  "version": "0.1.0",
  "description": "Autonomous hierarchical-agent runtime for a MuJoCo humanoid in an interactive 3D world",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multi-zhangyang/hear-3d-robot.git"
  },
  "bugs": {
    "url": "https://github.com/multi-zhangyang/hear-3d-robot/issues"
  },
  "homepage": "https://github.com/multi-zhangyang/hear-3d-robot#readme",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "hear": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx watch src/cli.ts operator --host 127.0.0.1 --port 8765 --dev",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/cli.js operator",
    "hear": "tsx src/cli.ts",
    "check:dead": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:production": "pnpm run build && node tests/production-smoke.mjs",
    "test:live": "pnpm run test:live:mission",
    "test:live:mission": "pnpm run build:server && node tests/live-autonomy.mjs",
    "test:live:autonomy": "pnpm run build:server && node tests/live-autonomy-portfolio.mjs",
    "test:live:endurance": "pnpm run build:server && node tests/live-endurance.mjs",
    "test:live:portfolio": "pnpm run test:live:autonomy",
    "test:browser": "pnpm run build:web && playwright test",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "check": "pnpm run check:dead && pnpm run typecheck && pnpm run test && pnpm run test:production"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.102",
    "@ai-sdk/openai": "^3.0.88",
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@fastify/static": "^10.1.2",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mujoco/mujoco": "^3.11.0",
    "@openai/agents": "^0.14.2",
    "@openai/agents-extensions": "^0.14.2",
    "ai": "^6.0.235",
    "async-mutex": "^0.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.2",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recast-navigation": "^0.43.1",
    "three": "^0.185.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "knip": "^6.31.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
